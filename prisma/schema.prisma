// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model Product {
  id        String      @id @default(uuid())
  name      String
  stock     Int
  version   Int         @default(0)
  createdAt DateTime    @default(now())
  items     OrderItem[]
}

model Order {
  id             String      @id @default(uuid())
  status         OrderStatus @default(PENDING)
  idempotencyKey String?     @unique
  createdAt      DateTime    @default(now())
  items          OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model IdempotencyRecord {
  key            String   @id
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())
}

model WebhookEvent {
  eventId     String    @id
  type        String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([type, processedAt])
}

enum TableOrderStatus {
  OPEN
  SUBMITTED
  PREPARING
  READY
  SERVED
  CANCELLED
}

model Restaurant {
  id                  String   @id @default(uuid())
  slug                String   @unique
  name                String
  active              Boolean  @default(true)
  timezone            String   @default("Asia/Bangkok")
  openTime            String   @default("10:00")
  closeTime           String   @default("22:00")
  slotMinutes         Int      @default(30)
  durationMinutes     Int      @default(90)
  maxDaysAhead        Int      @default(30)
  minLeadMinutes      Int      @default(60)
  cancelCutoffMinutes Int      @default(120)
  maxParty            Int      @default(10)
  createdAt           DateTime @default(now())
  tables              DiningTable[]
  menu                 MenuItem[]
  reservations         Reservation[]
  sessions             DiningSession[]
  orders               TableOrder[]
  staff                StaffUser[]
  platformAudit        PlatformAudit[]
}

model PlatformAudit {
  id           String     @id @default(uuid())
  actor        String
  action       String
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  createdAt    DateTime   @default(now())
  @@index([restaurantId, createdAt])
}

model DiningTable {
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  @@unique([restaurantId, number])
  sessions DiningSession[]
  capacity Int @default(4)
  reservations Reservation[]
  id      String       @id @default(uuid())
  number  Int
  qrToken String       @unique
  active  Boolean      @default(true)
  orders  TableOrder[]
}

model DiningSession {
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  @@index([restaurantId])
  id             String      @id @default(uuid())
  tableId        String
  joinCode       String      @unique
  accessToken    String      @unique
  startedBy      String
  createdAt      DateTime    @default(now())
  endedAt        DateTime?
  endedBy        String?
  overrideReason String?
  table          DiningTable @relation(fields: [tableId], references: [id])
  orders         TableOrder[]

  @@index([tableId])
}

enum ReservationStatus {
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Reservation {
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  id        String            @id @default(uuid())
  tableId   String
  partySize Int
  startsAt  DateTime          @db.Timestamptz(3)
  endsAt    DateTime          @db.Timestamptz(3)
  status    ReservationStatus @default(CONFIRMED)
  guestName String
  phone     String
  email     String?
  notes     String?
  code      String            @unique
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  table     DiningTable       @relation(fields: [tableId], references: [id])

  @@index([restaurantId, startsAt])
}

model MenuItem {
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  @@index([restaurantId])
  id        String           @id @default(uuid())
  name      String
  priceMinor Int
  available Boolean          @default(true)
  imageKey  String?
  lines     TableOrderItem[]
}

model TableOrder {
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  @@index([restaurantId, status])
  version     Int              @default(0)
  sessionId   String?
  session     DiningSession?   @relation(fields: [sessionId], references: [id])
  id          String           @id @default(uuid())
  tableId     String
  status      TableOrderStatus @default(OPEN)
  totalMinor  Int              @default(0)
  submittedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  table       DiningTable      @relation(fields: [tableId], references: [id])
  items       TableOrderItem[]

  @@index([tableId])
}

model TableOrderItem {
  id             String     @id @default(uuid())
  orderId        String
  menuItemId     String
  nameSnapshot   String
  unitPriceMinor Int
  quantity       Int
  note           String?
  order          TableOrder @relation(fields: [orderId], references: [id])
  menuItem       MenuItem   @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
}

enum StaffRole {
  ADMIN
  KITCHEN
  SUPER_ADMIN
}

model StaffUser {
  restaurantId String?
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  mustChangePassword Boolean @default(false)
  credentialVersion  Int     @default(0)
  @@unique([restaurantId, username])
  id           String    @id @default(uuid())
  username     String
  passwordHash String
  role         StaffRole
  createdAt    DateTime  @default(now())
}
