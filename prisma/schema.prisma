// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model Product {
  id        String      @id @default(uuid())
  name      String
  stock     Int
  version   Int         @default(0)
  createdAt DateTime    @default(now())
  items     OrderItem[]
}

model Order {
  id             String      @id @default(uuid())
  status         OrderStatus @default(PENDING)
  idempotencyKey String?     @unique
  createdAt      DateTime    @default(now())
  items          OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model IdempotencyRecord {
  key            String   @id
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())
}

model WebhookEvent {
  eventId     String    @id
  type        String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([type, processedAt])
}

enum TableOrderStatus {
  OPEN
  SUBMITTED
  PREPARING
  READY
  SERVED
  CANCELLED
}

model DiningTable {
  id      String       @id @default(uuid())
  number  Int          @unique
  qrToken String       @unique
  active  Boolean      @default(true)
  orders  TableOrder[]
}

model MenuItem {
  id        String           @id @default(uuid())
  name      String
  priceMinor Int
  available Boolean          @default(true)
  lines     TableOrderItem[]
}

model TableOrder {
  id          String           @id @default(uuid())
  tableId     String
  status      TableOrderStatus @default(OPEN)
  totalMinor  Int              @default(0)
  submittedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  table       DiningTable      @relation(fields: [tableId], references: [id])
  items       TableOrderItem[]

  @@index([tableId])
}

model TableOrderItem {
  id             String     @id @default(uuid())
  orderId        String
  menuItemId     String
  nameSnapshot   String
  unitPriceMinor Int
  quantity       Int
  note           String?
  order          TableOrder @relation(fields: [orderId], references: [id])
  menuItem       MenuItem   @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
}

enum StaffRole {
  ADMIN
  KITCHEN
}

model StaffUser {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  role         StaffRole
  createdAt    DateTime  @default(now())
}
